<Window x:Class="Coach.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Hearthstone AI Coach" Width="1040" Height="750" MinWidth="750" MinHeight="590"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
 Background="{StaticResource Background}" FontFamily="Segoe UI" Loaded="OnLoaded" Closing="OnClosing">
 <Window.Resources>
  <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
  <Style x:Key="StatValue" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="Bold"/></Style>
  <Style x:Key="PanelBorder" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="17"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1"
          Background="#111822" MouseLeftButtonDown="TitleDrag">
   <Grid Margin="26,0,16,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource Accent}">
      <TextBlock Text="✦" FontSize="17" Foreground="#0B1920" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text=" HEARTHSTONE" FontWeight="Bold" FontSize="14" Margin="11,0,0,0" VerticalAlignment="Center"/>
     <TextBlock Text=" / AI COACH" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
     <Border Background="#273D35" CornerRadius="7" Margin="15,0,0,0" Padding="8,4">
      <TextBlock Text="BETA 0.1" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="10"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="—" Width="35" Height="30" Style="{StaticResource SecondaryButton}" Padding="0"
             Margin="0,0,7,0" Click="MinimizeClick"/>
     <Button Content="✕" Width="35" Height="30" Style="{StaticResource SecondaryButton}" Padding="0" Click="CloseClick"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="20">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="ASYSTENT GRY" Style="{StaticResource SectionHeading}" Margin="0,0,0,16"/>
      <Border Padding="14" CornerRadius="12" Background="#1B302B" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="●  Stan połączenia" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock x:Name="ConnectionText" Text="Sprawdzam HDT..." Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"/>
       </StackPanel>
      </Border>
      <TextBlock Text="TWOJA PARTIA" Style="{StaticResource SectionHeading}" Margin="0,4,0,13"/>
      <Border CornerRadius="12" Background="{StaticResource Panel2}" Padding="13">
       <StackPanel>
        <TextBlock x:Name="GamePhaseText" Text="Oczekiwanie na mecz" FontSize="13" TextWrapping="Wrap"/>
        <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="TURA" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="TurnText" Text="—" Style="{StaticResource StatValue}" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="MANA" Style="{StaticResource SectionHeading}"/><TextBlock x:Name="ManaText" Text="—" Style="{StaticResource StatValue}" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <TextBlock x:Name="HandText" Text="Ręka: —" Foreground="{StaticResource Muted}" Margin="0,16,0,0" FontSize="12"/>
        <TextBlock x:Name="ChoiceText" Text="Odkryj: —" Foreground="{StaticResource Muted}" Margin="0,5,0,0" FontSize="12"/>
       </StackPanel>
      </Border>
      <TextBlock Text="USTAWIENIA" Style="{StaticResource SectionHeading}" Margin="0,25,0,13"/>
      <CheckBox x:Name="AutoCheck" Content="Automatyczna analiza" IsChecked="True" Click="AutoChanged" Margin="0,0,0,16"/>
      <CheckBox x:Name="TopmostCheck" Content="Przypnij nad grą" Click="TopmostChanged"/>
      <TextBlock Text="AI analizuje zmiany z ograniczeniem liczby zapytań. Nie wykonuje żadnych ruchów." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,21,0,0" LineHeight="18"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
      <Border Background="{StaticResource Panel2}" CornerRadius="11" Padding="12">
       <StackPanel>
        <TextBlock Text="CHATGPT PLAN" Style="{StaticResource SectionHeading}"/>
        <TextBlock x:Name="AccountText" Text="Nie połączono" Margin="0,8,0,10" FontSize="12" TextWrapping="Wrap"/>
        <Button x:Name="SignInButton" Content="Połącz przez ChatGPT" Style="{StaticResource PrimaryButton}" Click="SignInClick"/>
        <Button x:Name="SignOutButton" Content="Wyloguj" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="SignOutClick" Visibility="Collapsed"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="Twój trener podczas gry" FontSize="28" FontWeight="Bold" Margin="1,2,0,5"/>
     <TextBlock Text="Podpowiedzi w czasie rzeczywistym, bez ingerencji w Hearthstone." Foreground="{StaticResource Muted}" FontSize="13" Margin="1,0,0,24" TextWrapping="Wrap"/>
     <Border Style="{StaticResource PanelBorder}" Padding="22">
      <StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="NAJLEPSZY NASTĘPNY RUCH" Style="{StaticResource SectionHeading}"/>
         <TextBlock x:Name="AiStatus" Text="Oczekuję na Twoją turę" FontSize="20" FontWeight="SemiBold" Margin="0,11,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#20372F" CornerRadius="9" Padding="10,5" VerticalAlignment="Top">
         <TextBlock Text="✦ ANALIZA AI" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"/>
        </Border>
       </Grid>
       <Border Height="1" Background="{StaticResource Stroke}" Margin="0,20,0,18"/>
       <TextBlock x:Name="AdviceText" Text="Uruchom Hearthstone Deck Tracker, zaloguj się przez ChatGPT i rozpocznij partię. Gdy nadejdzie Twoja tura, pojawi się tutaj rekomendacja." TextWrapping="Wrap" FontSize="15" LineHeight="26" MinHeight="140"/>
       <TextBlock x:Name="AdviceMeta" Text="Analiza tylko na podstawie danych udostępnionych przez HDT." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource PanelBorder}" Padding="20" Margin="0,18,0,0">
      <StackPanel>
       <TextBlock Text="SILNIK AI" Style="{StaticResource SectionHeading}"/>
       <TextBlock Text="Modele dostępne w Twoim planie ChatGPT" FontSize="13" Margin="0,10,0,12"/>
       <ComboBox x:Name="ModelPicker" Height="39" Background="{StaticResource Panel2}" Foreground="#101820" FontSize="13" BorderThickness="0" Margin="0,0,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" x:Name="AnalyzeButton" Style="{StaticResource PrimaryButton}" Content="✦  Analizuj teraz" Click="AnalyzeClick"/>
        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Moje zużycie ChatGPT ↗" Click="UsageClick"/>
       </Grid>
      </StackPanel>
     </Border>
     <TextBlock Text="Analiza jest orientacyjna: brak dostępu do ukrytych kart, a możliwości ruchów zależą od poprawności odczytu HDT." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="5,18,5,0"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>