<Window x:Class="Coach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthstone AI Coach"
        Width="1090" Height="760" MinWidth="850" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Background}" FontFamily="Segoe UI"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Kicker" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
        </Style>
        <Style x:Key="BodyMuted" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#111A25"
                BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleDrag">
            <Grid Margin="23,0,19,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="11"
                            Background="{StaticResource Accent}">
                        <TextBlock Text="✦" Foreground="#09221A" FontSize="23"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="Bold">
                            <Run Text="Hearthstone"/><Run Text="  AI Coach" Foreground="{StaticResource Muted}" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock Text="Twój asystent rozgrywki" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Background="{StaticResource AccentTint}" Padding="9,5"
                            CornerRadius="7" Margin="17,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BETA 0.2" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStateBadge" Background="{StaticResource NeutralTint}"
                            CornerRadius="9" Padding="11,7" Margin="0,0,17,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HeaderIndicator" Width="7" Height="7" Fill="{StaticResource Muted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="HeaderStatusText" Text="Sprawdzanie HDT" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <Button Content="−" ToolTip="Minimalizuj" Style="{StaticResource ChromeButton}"
                            Click="MinimizeClick" Margin="0,0,7,0"/>
                    <Button Content="×" ToolTip="Zamknij" Style="{StaticResource ChromeButton}"
                            Click="CloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,22,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="278"/>
                <ColumnDefinition Width="21"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar scrolls independently; account card never overlays settings. -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <TextBlock Text="POŁĄCZENIE" Style="{StaticResource Kicker}" Margin="2,2,0,12"/>
                        <Border x:Name="ConnectionCard" Background="{StaticResource NeutralTint}"
                                CornerRadius="12" Padding="14" Margin="0,0,0,22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                                             Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ConnectionTitle" Text="Oczekiwanie na HDT"
                                               FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="ConnectionText" Text="Sprawdzam plik rozgrywki…"
                                           Margin="0,8,0,0" Foreground="{StaticResource Muted}"
                                           FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ROZGRYWKA" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                        <Border Background="{StaticResource Panel2}" CornerRadius="12"
                                Padding="15" Margin="0,0,0,23">
                            <StackPanel>
                                <TextBlock x:Name="GamePhaseText" Text="Oczekiwanie na mecz"
                                           FontSize="12" Foreground="{StaticResource White}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TURA" Style="{StaticResource Kicker}"/>
                                        <TextBlock x:Name="TurnText" Text="—" FontSize="27" FontWeight="Bold"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MANA" Style="{StaticResource Kicker}"/>
                                        <TextBlock x:Name="ManaText" Text="—" FontSize="27" FontWeight="Bold"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HandText" Text="Ręka: —" FontSize="11"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="ChoiceText" Grid.Column="1"
                                               Text="Wybory: —" FontSize="11"
                                               Foreground="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PREFERENCJE" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                        <Border Background="{StaticResource Panel2}" CornerRadius="12"
                                Padding="14" Margin="0,0,0,23">
                            <StackPanel>
                                <CheckBox x:Name="AutoCheck" Content="Automatyczna analiza"
                                          IsChecked="True" Style="{StaticResource SwitchToggle}"
                                          Click="AutoChanged" Margin="0,0,0,8"/>
                                <CheckBox x:Name="TopmostCheck" Content="Przypnij nad grą"
                                          Style="{StaticResource SwitchToggle}" Click="TopmostChanged"/>
                                <TextBlock Text="Nowe podpowiedzi po zmianie sytuacji na planszy."
                                           Style="{StaticResource BodyMuted}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="KONTO CHATGPT" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                        <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="AccountDot" Width="7" Height="7"
                                             Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="AccountStateText" Text="Nie połączono"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="AccountText" Text="Połącz konto ChatGPT"
                                           FontSize="12" Foreground="{StaticResource Muted}"
                                           Margin="0,9,0,13" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button x:Name="SignInButton" Content="Połącz przez ChatGPT"
                                        Style="{StaticResource PrimaryButton}" Click="SignInClick"/>
                                <Button x:Name="SignOutButton" Content="Wyloguj z ChatGPT"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="SignOutClick" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main content -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,2,9,2">
                    <TextBlock Text="ASYSTENT W CZASIE GRY"
                               Foreground="{StaticResource Accent}" FontSize="11"
                               FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <TextBlock Text="Twoja kolej. Twój najlepszy ruch."
                               FontWeight="Bold" FontSize="25" Margin="0,0,0,7"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Analiza ręki, planszy i wyborów kart — bez przełączania okien."
                               FontSize="13" Foreground="{StaticResource Muted}"
                               Margin="1,0,0,23" TextWrapping="Wrap"/>

                    <Border Style="{StaticResource Card}" Padding="23" MinHeight="272">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A332D" Offset="0"/>
                                <GradientStop Color="#16252C" Offset="0.37"/>
                                <GradientStop Color="#121D29" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="9" Background="{StaticResource AccentTint}"
                                            Width="35" Height="35" Margin="0,0,11,0">
                                        <TextBlock Text="✦" Foreground="{StaticResource Accent}"
                                                   FontSize="21" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="REKOMENDACJA" Style="{StaticResource Kicker}"/>
                                        <TextBlock x:Name="AiStatus" Text="Oczekiwanie na rozgrywkę"
                                                   Foreground="{StaticResource Accent}"
                                                   FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource AccentTint}"
                                        CornerRadius="8" Padding="11,6" VerticalAlignment="Top">
                                    <TextBlock Text="AI COACH" Foreground="{StaticResource Accent}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="MoveText" Text="Czekam na dane z gry"
                                       FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,24,0,14" LineHeight="32"/>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,15"/>
                            <TextBlock x:Name="AdviceText"
                                       Text="Gdy nadejdzie Twoja tura, zobaczysz tutaj proponowane zagranie i jego uzasadnienie."
                                       Foreground="#C3D0DD" FontSize="13" LineHeight="22"
                                       TextWrapping="Wrap" MinHeight="70"/>
                            <TextBlock x:Name="AdviceMeta"
                                       Text="Podpowiedzi wykorzystują wyłącznie aktualne dane HDT."
                                       Foreground="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,17,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="21">
                        <StackPanel>
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SILNIK ANALIZY" Style="{StaticResource Kicker}"/>
                                    <TextBlock Text="Model w Twoim planie ChatGPT"
                                               FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource NeutralTint}"
                                        CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                    <TextBlock Text="Bez klucza API" Foreground="{StaticResource Muted}"
                                               FontSize="11"/>
                                </Border>
                            </Grid>
                            <ComboBox x:Name="ModelPicker" Height="44"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,15"
                                      ToolTip="Wybierz model udostępniony na Twoim koncie ChatGPT"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="AnalyzeButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="✦  Analizuj teraz" Click="AnalyzeClick"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Zużycie planu  ↗" Click="UsageClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="11" BorderBrush="{StaticResource Stroke}"
                            BorderThickness="1" Background="#111B27"
                            Padding="15,13" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ⓘ" Foreground="{StaticResource Muted}"
                                       FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="AI nie wykonuje ruchów. Rekomendacje mogą być niedokładne, jeśli tracker nie widzi wszystkich efektów kart."
                                       Foreground="{StaticResource Muted}" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>