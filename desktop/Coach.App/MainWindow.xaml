<Window x:Class="Coach.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthstone AI Coach"
        Width="1090" Height="760" MinWidth="850" MinHeight="590"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Background}" FontFamily="Segoe UI"
        Loaded="OnLoaded" Closing="OnClosing">
    <!-- Remove the native white top frame; keep Windows resize hit-testing. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" NonClientFrameEdges="None"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Kicker" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Card" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="17"/>
        </Style>
        <Style x:Key="BodyMuted" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <DataTemplate x:Key="HistoryCardTemplate">
            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" CornerRadius="10" Padding="8"
                    Width="116" Margin="0,0,9,9">
                <StackPanel>
                    <Grid Width="82" Height="112" HorizontalAlignment="Center">
                        <Border Background="{StaticResource NeutralTint}" CornerRadius="8">
                            <TextBlock Text="HS" FontWeight="Bold" Foreground="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image Source="{Binding Art}" Stretch="Uniform">
                            <Image.ToolTip>
                                <ToolTip>
                                    <Image Source="{Binding Art}" Width="250" Stretch="Uniform"/>
                                </ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,7,0,0" MaxHeight="42"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact, integrated desktop title bar. The open center remains draggable. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Stroke}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#172B2E" Offset="0"/>
                    <GradientStop Color="#13232C" Offset="0.38"/>
                    <GradientStop Color="#101A25" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="22,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Vector mark stays sharp at different Windows DPI settings. -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12"
                        Background="#1E443B" BorderBrush="#37695A" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <Path Width="23" Height="23" Stretch="Uniform"
                              Fill="{StaticResource Accent}"
                              Data="M12,1 L14.8,8.2 22,11 14.8,13.8 12,21 9.2,13.8 2,11 9.2,8.2 Z"/>
                        <Ellipse Width="3" Height="3" Fill="#C9FFEB"
                                 VerticalAlignment="Top" HorizontalAlignment="Right"
                                 Margin="0,7,6,0"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Hearthstone" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource White}" VerticalAlignment="Center"/>
                        <TextBlock Text="  AI Coach" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <Border Margin="11,0,0,0" Padding="7,3" CornerRadius="6"
                                BorderBrush="#376255" BorderThickness="1"
                                Background="#1B3B33" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Asystent rozgrywki na żywo" FontSize="11"
                               Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Live game state (names are used by MainWindow.xaml.cs). -->
                <Border x:Name="HeaderStateBadge" Grid.Column="3"
                        Background="{StaticResource NeutralTint}" CornerRadius="11"
                        BorderBrush="#35524D" BorderThickness="1"
                        Padding="11,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="27" Height="27" CornerRadius="8"
                                Background="#23443E" VerticalAlignment="Center">
                            <Ellipse x:Name="HeaderIndicator" Width="8" Height="8"
                                     Fill="{StaticResource Muted}" VerticalAlignment="Center"
                                     HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,2,0" VerticalAlignment="Center">
                            <TextBlock Text="STATUS ROZGRYWKI" FontSize="9"
                                       FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="HeaderStatusText" Text="Sprawdzanie HDT"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}" Margin="0,3,0,0"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Width="1" Height="26"
                        Background="{StaticResource Stroke}" Margin="16,0,13,0"
                        VerticalAlignment="Center"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="−" ToolTip="Minimalizuj" 
                            AutomationProperties.Name="Minimalizuj okno"
                            Style="{StaticResource ChromeButton}"
                            Click="MinimizeClick" Margin="0,0,8,0"/>
                    <Button Content="×" ToolTip="Zamknij"
                            AutomationProperties.Name="Zamknij okno"
                            Style="{StaticResource CloseChromeButton}"
                            Click="CloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,22,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="278"/>
                <ColumnDefinition Width="21"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Persistent game status; configuration lives on its own page. -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="17">
                <ScrollViewer VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel>
                        <TextBlock Text="NAWIGACJA" Style="{StaticResource Kicker}" Margin="2,2,0,12"/>
                        <Button x:Name="MainNavButton" Content="⌂   Główna"
                                Style="{StaticResource SecondaryButton}"
                                Background="{StaticResource AccentTint}" Foreground="{StaticResource Accent}"
                                Click="NavigateClick" Margin="0,0,0,8"/>
                        <Button x:Name="SettingsNavButton" Content="⚙   Ustawienia"
                                Style="{StaticResource SecondaryButton}"
                                Click="NavigateClick" Margin="0,0,0,8"/>
                        <Button x:Name="HistoryNavButton" Content="▤   Match History"
                                Style="{StaticResource SecondaryButton}"
                                Click="NavigateClick" Margin="0,0,0,24"/>
                        <TextBlock Text="POŁĄCZENIE" Style="{StaticResource Kicker}" Margin="2,2,0,12"/>
                        <Border x:Name="ConnectionCard" Background="{StaticResource NeutralTint}"
                                CornerRadius="12" Padding="14" Margin="0,0,0,22">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                                             Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ConnectionTitle" Text="Oczekiwanie na HDT"
                                               FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="ConnectionText" Text="Sprawdzam plik rozgrywki…"
                                           Margin="0,8,0,0" Foreground="{StaticResource Muted}"
                                           FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="ROZGRYWKA" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                        <Border Background="{StaticResource Panel2}" CornerRadius="12"
                                Padding="15" Margin="0,0,0,23">
                            <StackPanel>
                                <TextBlock x:Name="GamePhaseText" Text="Oczekiwanie na mecz"
                                           FontSize="12" Foreground="{StaticResource White}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TURA" Style="{StaticResource Kicker}"/>
                                        <TextBlock x:Name="TurnText" Text="—" FontSize="27" FontWeight="Bold"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="MANA" Style="{StaticResource Kicker}"/>
                                        <TextBlock x:Name="ManaText" Text="—" FontSize="27" FontWeight="Bold"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource Stroke}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="HandText" Text="Ręka: —" FontSize="11"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="ChoiceText" Grid.Column="1"
                                               Text="Wybory: —" FontSize="11"
                                               Foreground="{StaticResource Muted}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Main content -->
            <ScrollViewer x:Name="MainPage" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,2,9,2">
                    <TextBlock Text="ASYSTENT GRY"
                               Foreground="{StaticResource Accent}" FontSize="11"
                               FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <TextBlock Text="Co teraz zagrać?"
                               FontWeight="Bold" FontSize="25" Margin="0,0,0,6"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Konkretny ruch na pierwszym miejscu. Reszta — tylko gdy potrzebna."
                               FontSize="12" Foreground="{StaticResource Muted}"
                               Margin="1,0,0,19" TextWrapping="Wrap"/>

                    
                    <!-- Mulligan: independent horizontal card strip. -->
                    <Border x:Name="MulliganPanel" Style="{StaticResource Card}"
                            Padding="18" Margin="0,0,0,15" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="RĘKA POCZĄTKOWA · ZOSTAW / ODRZUĆ"
                                       Style="{StaticResource Kicker}" Foreground="{StaticResource Accent}"
                                       Margin="0,0,0,7"/>
                            <TextBlock Text="Decyzja nad każdą kartą, w kolejności z gry."
                                       FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="MulliganItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="174" Margin="0,0,10,8" Padding="10"
                                                    Background="{StaticResource Panel2}"
                                                    BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                                    CornerRadius="12">
                                                <StackPanel>
                                                    <Border CornerRadius="8" Padding="7,6" Margin="0,0,0,7">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="Background" Value="{StaticResource NeutralTint}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MulliganDecision}" Value="ZOSTAW">
                                                                        <Setter Property="Background" Value="{StaticResource AccentTint}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding MulliganDecision}" Value="ODRZUĆ">
                                                                        <Setter Property="Background" Value="#3B202C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding MulliganDecision}" FontSize="14"
                                                                   FontWeight="Bold" TextAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding MulliganDecision}" Value="ZOSTAW">
                                                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding MulliganDecision}" Value="ODRZUĆ">
                                                                            <Setter Property="Foreground" Value="#FDA4AF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <Grid Width="105" Height="146" HorizontalAlignment="Center">
                                                        <Border Background="{StaticResource NeutralTint}" CornerRadius="7"
                                                                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                                                            <TextBlock Text="{Binding Placeholder}" Opacity=".5"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Art}" Stretch="Uniform">
                                                            <Image.ToolTip>
                                                                <ToolTip>
                                                                    <Image Source="{Binding Art}" Width="260" Stretch="Uniform"/>
                                                                </ToolTip>
                                                            </Image.ToolTip>
                                                        </Image>
                                                    </Grid>
                                                    <TextBlock Text="{Binding IndexText, StringFormat='KARTA {0}'}"
                                                               HorizontalAlignment="Center" Margin="0,7,0,3"
                                                               FontSize="10" Foreground="{StaticResource Accent}"/>
                                                    <TextBlock Text="{Binding Caption}" FontSize="12"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                               TextAlignment="Center" MaxHeight="42"
                                                               ToolTip="{Binding Caption}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="21" MinHeight="180">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A332D" Offset="0"/>
                                <GradientStop Color="#14222B" Offset="0.45"/>
                                <GradientStop Color="#121D29" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border CornerRadius="9" Background="{StaticResource AccentTint}"
                                            Width="32" Height="32" Margin="0,0,11,0">
                                        <TextBlock Text="✦" Foreground="{StaticResource Accent}"
                                                   FontSize="21" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PLAN I REKOMENDACJE" Style="{StaticResource Kicker}"/>
                                        <TextBlock x:Name="AiStatus" Text="Oczekiwanie na rozgrywkę"
                                                   Foreground="{StaticResource Accent}"
                                                   FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource AccentTint}"
                                        CornerRadius="8" Padding="10,6" VerticalAlignment="Top">
                                    <TextBlock Text="AI COACH" Foreground="{StaticResource Accent}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="MoveText" Text="Czekam na swoją turę"
                                               Foreground="{StaticResource White}" FontSize="26"
                                               FontWeight="Bold" TextWrapping="Wrap"
                                               Margin="0,8,0,12" LineHeight="34"/>

                                    <!-- Compact visual plan; images are asynchronous and never hold up advice. -->
                                    <StackPanel x:Name="TurnPlanPanel" Visibility="Collapsed">
                                        <TextBlock Text="PLAN TURY" Style="{StaticResource Kicker}"
                                                   Foreground="{StaticResource Accent}" Margin="0,0,0,9"/>
                                        <ItemsControl x:Name="PlanItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Panel2}"
                                                            CornerRadius="12" Padding="10" Margin="0,0,0,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="92"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="84" Height="116" HorizontalAlignment="Left">
                                                                <Border Background="{StaticResource NeutralTint}"
                                                                        CornerRadius="7" BorderBrush="{StaticResource Stroke}"
                                                                        BorderThickness="1">
                                                                    <TextBlock Text="{Binding Placeholder}" Opacity=".6"
                                                                               VerticalAlignment="Center"
                                                                               HorizontalAlignment="Center"/>
                                                                </Border>
                                                                <Image Source="{Binding Art}" Stretch="Uniform">
                                                                    <Image.ToolTip>
                                                                        <ToolTip>
                                                                            <Image Source="{Binding Art}" Width="240"
                                                                                   Stretch="Uniform"/>
                                                                        </ToolTip>
                                                                    </Image.ToolTip>
                                                                </Image>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Accent}"
                                                                           Text="{Binding IndexText, StringFormat='KROK {0}'}"/>
                                                                <TextBlock Text="{Binding Caption}" FontSize="14"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                                           Margin="0,4,0,0"/>
                                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                                           TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                                                           Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Kolejne akcje są planem warunkowym — reaguj na zmiany planszy."
                                                   Style="{StaticResource BodyMuted}" FontSize="10"
                                                   Margin="2,3,0,9"/>
                                    </StackPanel>

                                    <Border x:Name="TargetPanel" Visibility="Collapsed"
                                            Background="{StaticResource AccentTint}" Padding="12,9"
                                            CornerRadius="9" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CEL →" Foreground="{StaticResource Accent}"
                                                       FontWeight="Bold" FontSize="12" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="TargetText" Grid.Column="1"
                                                       Foreground="{StaticResource White}"
                                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="NextPanel" Visibility="Collapsed"
                                            BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="NASTĘPNIE" Style="{StaticResource Kicker}" Margin="0,0,0,7"/>
                                            <TextBlock x:Name="AdviceText" Text=""
                                                       Foreground="#D4E3EE" FontSize="13"
                                                       LineHeight="21" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="WhyPanel" Visibility="Collapsed"
                                            BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0" Margin="0,13,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DLACZEGO?" Style="{StaticResource Kicker}" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="WhyText" Foreground="{StaticResource Muted}"
                                                       FontSize="12" LineHeight="20" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Discover is an independent sidebar: never replaces the turn plan. -->
                                <Border x:Name="ChoicePanel" Grid.Column="1" Visibility="Collapsed"
                                        Width="252" Margin="12,0,0,0"
                                        Background="{StaticResource Panel2}" CornerRadius="12"
                                        BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                        Padding="10" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="AKTYWNY WYBÓR" Style="{StaticResource Kicker}"
                                                   Foreground="{StaticResource Accent}" Margin="0,1,0,6"/>
                                        <TextBlock x:Name="ChoiceHeadline" Text="Sprawdzam opcje…"
                                                   FontWeight="Bold" FontSize="16"
                                                   Foreground="{StaticResource White}" TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
                                        <ItemsControl x:Name="ChoiceItems">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="9" BorderThickness="1"
                                                            Margin="0,0,0,7" Padding="6">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
                                                                <Setter Property="Background" Value="{StaticResource Panel}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Recommended}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                                        <Setter Property="Background" Value="{StaticResource AccentTint}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="72"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="66" Height="93" HorizontalAlignment="Left">
                                                                <Border Background="{StaticResource NeutralTint}" CornerRadius="6">
                                                                    <TextBlock Text="HS" Foreground="{StaticResource Muted}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Image Source="{Binding Art}" Stretch="Uniform">
                                                                    <Image.ToolTip>
                                                                        <ToolTip>
                                                                            <Image Source="{Binding Art}"
                                                                                   Width="240" Stretch="Uniform"/>
                                                                        </ToolTip>
                                                                    </Image.ToolTip>
                                                                </Image>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding IndexText, StringFormat='KARTA {0}'}"
                                                                           Foreground="{StaticResource Accent}" FontSize="10"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Caption}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="AdviceMeta"
                                       Text="Poczekaj na stabilny początek tury, aby otrzymać poradę."
                                       Foreground="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,15,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="21">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="SZYBKA ANALIZA" Style="{StaticResource Kicker}"/>
                                <TextBlock Text="Analizuj AI" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                <TextBlock Text="Model i pozostałe opcje zmienisz w Ustawieniach."
                                           Style="{StaticResource BodyMuted}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="AnalyzeButton"
                                    MinWidth="164" Style="{StaticResource PrimaryButton}"
                                    Content="✦  Analizuj AI" Click="AnalyzeClick"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border CornerRadius="11" BorderBrush="{StaticResource Stroke}"
                            BorderThickness="1" Background="#111B27"
                            Padding="15,13" Margin="0,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ⓘ" Foreground="{StaticResource Muted}"
                                       FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="AI nie wykonuje ruchów. Rekomendacje mogą być niedokładne, jeśli tracker nie widzi wszystkich efektów kart."
                                       Foreground="{StaticResource Muted}" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Configuration page: the controls remain alive when navigating, preserving state. -->
            <ScrollViewer x:Name="SettingsPage" Grid.Column="2" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,2,9,2">
                    <TextBlock Text="USTAWIENIA" Foreground="{StaticResource Accent}"
                               FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <TextBlock Text="Konfiguracja asystenta" FontSize="25" FontWeight="Bold"
                               Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="Dostosuj działanie AI i połączenie z Hearthstone Deck Tracker."
                               Style="{StaticResource BodyMuted}" Margin="1,0,0,21"/>

                    <TextBlock Text="PREFERENCJE" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="21" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="AutoCheck" Content="Automatyczna analiza"
                                      IsChecked="True" Style="{StaticResource SwitchToggle}"
                                      Click="AutoChanged"/>
                            <TextBlock Text="Nowe podpowiedzi po zmianie sytuacji na planszy."
                                       Style="{StaticResource BodyMuted}" Margin="0,9,0,0"/>
                            <Border Height="1" Background="{StaticResource Stroke}" Margin="0,17,0,17"/>
                            <CheckBox x:Name="TopmostCheck" Content="Przypnij nad grą"
                                      Style="{StaticResource SwitchToggle}" Click="TopmostChanged"/>
                            <TextBlock Text="Wyświetlaj okno asystenta ponad oknem gry."
                                       Style="{StaticResource BodyMuted}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SILNIK ANALIZY" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="21" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,17">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Model w Twoim planie ChatGPT"
                                           FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="{StaticResource NeutralTint}"
                                        CornerRadius="8" Padding="10,6" VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                    <TextBlock Text="Bez klucza API" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </Border>
                            </Grid>
                            <ComboBox x:Name="ModelPicker" Height="44"
                                      Style="{StaticResource DarkComboBox}"
                                      ToolTip="Wybierz model udostępniony na Twoim koncie ChatGPT"/>
                            <Button Content="Zużycie planu  ↗" Style="{StaticResource SecondaryButton}"
                                    Click="UsageClick" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AKTUALIZACJE APLIKACJI" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="21" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Hearthstone AI Coach"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="AppVersionText"
                                       Text="Wersja: sprawdzanie..." Style="{StaticResource BodyMuted}"
                                       Margin="0,0,0,12"/>
                            <Button x:Name="UpdateAppButton" Content="Sprawdź aktualizacje ↻"
                                    Style="{StaticResource PrimaryButton}" Click="UpdateAppClick"
                                    ToolTip="Pobierz nowe wydanie programu z GitHuba i uruchom aplikację ponownie"/>
                            <TextBlock x:Name="AppUpdateStatus"
                                       Text="Sprawdzam dostępność nowej wersji. Aktualizacja jest możliwa poza meczem."
                                       Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,11,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="WŁĄCZENIE HDT" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="21" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Wtyczka Hearthstone Deck Tracker"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Button x:Name="UpdatePluginButton" Content="Aktualizuj wtyczkę HDT ↻"
                                    Style="{StaticResource SecondaryButton}" Click="UpdatePluginClick"
                                    ToolTip="Sprawdź GitHub, a przy braku połączenia użyj DLL wbudowanej w program; zamknij HDT, podmień plik i uruchom go ponownie"/>
                            <TextBlock x:Name="PluginUpdateStatus"
                                       Text="Działa także bez GitHuba (DLL jest w aplikacji). Tylko poza meczem."
                                       Style="{StaticResource BodyMuted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="KONTO CHATGPT" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="21" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="AccountDot" Width="7" Height="7"
                                         Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="AccountStateText" Text="Nie połączono"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="AccountText" Text="Połącz konto ChatGPT"
                                       FontSize="12" Foreground="{StaticResource Muted}"
                                       Margin="0,9,0,13" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button x:Name="SignInButton" Content="Połącz przez ChatGPT"
                                    Style="{StaticResource PrimaryButton}" Click="SignInClick"/>
                            <Button x:Name="SignOutButton" Content="Wyloguj z ChatGPT"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SignOutClick" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DIAGNOSTYKA" Style="{StaticResource Kicker}" Margin="2,0,0,12"/>
                    <Border Style="{StaticResource Card}" Padding="21">
                        <StackPanel>
                            <TextBlock Text="Logi działania aplikacji" FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>
                            <Button Content="Otwórz logi diagnostyczne ↗"
                                    Style="{StaticResource SecondaryButton}" Click="OpenLogsClick"
                                    ToolTip="Otwórz folder dzienników tej aplikacji"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Separate archive view. Keeping it in the main column preserves the sidebar. -->
            <Grid x:Name="HistoryPage" Grid.Column="2" Visibility="Collapsed" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="ARCHIWUM ROZGRYWEK"
                               Style="{StaticResource Kicker}" Foreground="{StaticResource Accent}"
                               Margin="2,0,0,8"/>
                    <TextBlock Text="Match History" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Zapisane mecze i rzeczywiście zaobserwowane zagrania kart."
                               Foreground="{StaticResource Muted}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="218"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <TextBlock x:Name="HistoryEmptyText" Text="Brak zapisanych meczów. Uruchom rozgrywkę z włączonym HDT."
                                       Style="{StaticResource BodyMuted}" Margin="5,12,5,0"
                                       TextWrapping="Wrap"/>
                            <ListBox x:Name="HistoryMatchList"
                                     Background="Transparent" BorderThickness="0"
                                     SelectionChanged="HistorySelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="Padding" Value="3"/>
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentTint}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5">
                                            <TextBlock Text="{Binding Date}" FontSize="11"
                                                       Foreground="{StaticResource Muted}"/>
                                            <TextBlock Text="{Binding Opponents}" FontWeight="SemiBold"
                                                       FontSize="12" TextWrapping="Wrap" Margin="0,7,0,5"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding State}" FontSize="10"
                                                       Foreground="{StaticResource Accent}"
                                                       FontWeight="SemiBold" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                        <Grid>
                            <TextBlock x:Name="HistoryNoSelectionText"
                                       Text="Wybierz mecz z listy po lewej stronie."
                                       Foreground="{StaticResource Muted}" FontSize="13"
                                       TextWrapping="Wrap" Margin="6,8,6,0"/>
                            <ScrollViewer x:Name="HistoryDetailPanel" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="HistoryTitle" FontWeight="Bold" FontSize="19"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="HistoryStats" FontSize="12"
                                               Foreground="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="HistoryCoverageText" Foreground="{StaticResource Warning}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                    <TextBlock Text="Wynik nieustalony — HDT nie przesyła jeszcze wyniku meczu."
                                               Foreground="{StaticResource Muted}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,7,0,13"/>
                                    <Border Height="1" Background="{StaticResource Stroke}"
                                            Margin="0,0,0,12"/>
                                    <TextBlock x:Name="HistoryNoEventsText" Visibility="Collapsed"
                                               Style="{StaticResource BodyMuted}"
                                               Text="Nie zarejestrowano jeszcze zagranych kart."/>
                                    <ItemsControl x:Name="HistoryTurnList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Panel}"
                                                        BorderBrush="{StaticResource Stroke}"
                                                        BorderThickness="1" CornerRadius="12"
                                                        Padding="13" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Heading}"
                                                                   Foreground="{StaticResource Accent}"
                                                                   FontSize="12" FontWeight="Bold"
                                                                   Margin="0,0,0,10"/>
                                                        <TextBlock Text="TWOJE KARTY" Style="{StaticResource Kicker}"
                                                                   Margin="0,0,0,7"/>
                                                        <ItemsControl ItemsSource="{Binding Mine}"
                                                                      ItemTemplate="{StaticResource HistoryCardTemplate}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                        <Border Height="1" Background="{StaticResource Stroke}"
                                                                Margin="0,4,0,11"/>
                                                        <TextBlock Text="KARTY PRZECIWNIKA" Style="{StaticResource Kicker}"
                                                                   Margin="0,0,0,7"/>
                                                        <ItemsControl ItemsSource="{Binding Theirs}"
                                                                      ItemTemplate="{StaticResource HistoryCardTemplate}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>