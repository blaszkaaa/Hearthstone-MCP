<Application x:Class="Coach.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml"><Application.Resources>
 <SolidColorBrush x:Key="Background" Color="#0A0F15"/>
 <SolidColorBrush x:Key="Panel" Color="#131B25"/>
 <SolidColorBrush x:Key="Panel2" Color="#1B2633"/>
 <SolidColorBrush x:Key="Stroke" Color="#2B3745"/>
 <SolidColorBrush x:Key="White" Color="#F0F6FA"/>
 <SolidColorBrush x:Key="Muted" Color="#96A6B5"/>
 <SolidColorBrush x:Key="Accent" Color="#8BE3BC"/>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource White}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
 <Style TargetType="Button" x:Key="PrimaryButton"><Setter Property="Foreground" Value="#081713"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="19,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Foreground" Value="{StaticResource White}"/><Setter Property="Background" Value="{StaticResource Panel2}"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource White}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
 </Application.Resources></Application>